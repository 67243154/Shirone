---
import LanguageSwitch from "@components/organisms/LanguageSwitch.astro";
import LightDarkSwitch from "@components/organisms/LightDarkSwitch.svelte";
import { url } from "@utils/url-utils";
import { Icon } from "astro-icon/components";
import { siteConfig } from "@/config/siteConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import Layout from "./Layout.astro";
---
<Layout title={i18n(I18nKey.adminTitle)} description={i18n(I18nKey.adminSubtitle)}>
 <meta slot="head" name="robots" content="noindex, nofollow" />
 <header class="admin-header">
  <a href={url("/")} data-no-swup class="admin-brand"><Icon name="material-symbols:auto-stories-rounded" />{siteConfig.title}<span>{i18n(I18nKey.adminTitle)}</span></a>
  <div class="admin-controls"><LightDarkSwitch client:load /><LanguageSwitch /></div>
 </header>
 <slot />
</Layout>
<style>
 .admin-header {display:flex;align-items:center;justify-content:space-between;gap:var(--m3e-space-4);padding:var(--m3e-space-4) var(--m3e-space-6);border-bottom:1px solid var(--outline-variant);background:var(--surface-container-lowest);color:var(--on-surface);}
 .admin-brand {display:flex;align-items:center;gap:var(--m3e-space-3);font:var(--m3e-type-title-large);font-weight:600;min-width:0;}
 .admin-brand svg {color:var(--primary);font-size:1.5rem;flex-shrink:0;}
 .admin-brand span {font:var(--m3e-type-label-large);color:var(--on-surface-variant);padding-left:var(--m3e-space-3);border-left:1px solid var(--outline-variant);}
 .admin-controls {display:flex;flex-shrink:0;gap:var(--m3e-space-2);}
 @media(max-width:600px) {.admin-header {padding:var(--m3e-space-3) var(--m3e-space-4);} .admin-brand span {display:none;}}
</style>
