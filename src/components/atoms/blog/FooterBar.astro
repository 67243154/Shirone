---
/**
 * M3E 博客原子 — FooterBar 页脚栏。
 * 数据驱动：copyright（名称/年份）+ 链接组 + 归属行；链接 primary 强调。
 */
interface FooterLink {
	label: string;
	href: string;
	external?: boolean;
}

interface Props {
	/** 站点 / 作者名 */
	name: string;
	/** 版权年份（默认当前年） */
	year?: number;
	links?: FooterLink[];
	poweredBy?: FooterLink[];
	version?: string;
	versionHref?: string;
	/** 自定义注入的页脚 HTML（来自 FooterConfig.html） */
	customHtml?: string;
	registration?: {
		icpText: string;
		policeText: string;
		policeCode: string;
		image: string;
		badgeLabel: string;
	};
	class?: string;
}

const {
	name,
	year = new Date().getFullYear(),
	links = [],
	poweredBy = [],
	version = "",
	versionHref = "",
	customHtml = "",
	registration,
	class: className,
} = Astro.props;
---

<footer class:list={["m3-blog-footer", className]}>
	<div class="m3-blog-footer__divider" aria-hidden="true" />
	<div class="m3-blog-footer__inner">
		{registration && (
			<div class="m3-blog-footer__registration">
				<a href="https://beian.miit.gov.cn/" target="_blank" rel="noopener noreferrer" class="m3-blog-footer__link">{registration.icpText}</a>
				<a href={registration.policeCode ? `https://beian.mps.gov.cn/#/query/webSearch?code=${encodeURIComponent(registration.policeCode)}` : "https://beian.mps.gov.cn/"} target="_blank" rel="noopener noreferrer" class="m3-blog-footer__link m3-blog-footer__police">
					{registration.image ? <img src={registration.image} alt="" width="20" height="20" loading="lazy" /> : <span class="m3-blog-footer__badge-placeholder" title={registration.badgeLabel} aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="3" y="3" width="18" height="18" rx="3" stroke="currentColor" stroke-dasharray="3 2" /><path d="m6 17 5-5 3 3 4-4" stroke="currentColor" /></svg></span>}
					{registration.policeText}
				</a>
			</div>
		)}
		{customHtml && <div class="m3-blog-footer__custom" set:html={customHtml} />}
		<p class="m3-blog-footer__text">
			&copy; {year} {name}. All Rights Reserved.
			{links.map((l) => (
				<Fragment>
					<span class="m3-blog-footer__sep" aria-hidden="true">/</span>
					<a
						class="m3-blog-footer__link"
						href={l.href}
						target={l.external ? "_blank" : undefined}
						rel={l.external ? "noopener noreferrer" : undefined}
					>{l.label}</a>
				</Fragment>
			))}
		</p>
		{poweredBy.length > 0 && (
			<p class="m3-blog-footer__text">
				Powered by{" "}
				{poweredBy.map((l, i) => (
					<Fragment>
						{i > 0 && <span class="m3-blog-footer__sep" aria-hidden="true">&amp;</span>}
						<a
							class="m3-blog-footer__link"
							href={l.href}
							target={l.external ? "_blank" : undefined}
							rel={l.external ? "noopener noreferrer" : undefined}
						>{l.label}</a>
					</Fragment>
				))}
				{version && (
					<Fragment>
						<span class="m3-blog-footer__sep" aria-hidden="true">/</span>
						<span class="m3-blog-footer__version">
							<span>Version</span>
							{versionHref ? (
								<a
									class="m3-blog-footer__link"
									href={versionHref}
									target="_blank"
									rel="noopener noreferrer"
								>{version}</a>
							) : version}
						</span>
					</Fragment>
				)}
			</p>
		)}
	</div>
</footer>

<style lang="stylus">
.m3-blog-footer
	&__registration
		display: flex
		flex-wrap: wrap
		justify-content: center
		align-items: center
		gap: var(--m3e-space-2) var(--m3e-space-4)
		font: var(--m3e-type-body-small)
	&__police
		display: inline-flex
		align-items: center
		gap: var(--m3e-space-1)
		img
			object-fit: contain
	&__badge-placeholder
		display: inline-flex
		width: 1.25rem
		height: 1.25rem
		color: var(--on-surface-variant)
		svg
			width: 100%
			height: 100%
	&__divider
		border-top: 1px dashed var(--outline-variant)
		margin: 2.5rem 2rem 1.5rem

	&__inner
		display: flex
		flex-direction: column
		align-items: center
		gap: 0.375rem
		margin: 0 auto 3rem
		padding: 0 1.5rem
		text-align: center

	&__text,
	&__custom
		font: var(--m3e-type-body-small)
		color: var(--on-surface-variant)
		line-height: 1.7
		a
			font-weight: 500
			color: var(--primary)
			text-decoration: none
			transition: opacity var(--m3e-duration-short) var(--m3e-easing-standard)
			&:hover
				opacity: 0.8

	&__link
		font-weight: 500
		color: var(--primary)
		text-decoration: none
		transition: opacity var(--m3e-duration-short) var(--m3e-easing-standard)
		&:hover
			opacity: 0.8

	&__sep
		margin: 0 0.5rem
		color: var(--outline-variant)

	&__version
		display: inline-flex
		align-items: baseline
		gap: 0.375rem
</style>
